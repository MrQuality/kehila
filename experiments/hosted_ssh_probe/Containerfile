FROM docker.io/library/python@sha256:14a4933e6cef421424f7a66d89a3f4eafcbd0d90e0a822251f298e05132dc735
RUN apt-get update && apt-get install -y --no-install-recommends openssh-server coreutils \
    && rm -f /etc/ssh/ssh_host_* \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin probe \
    && usermod --password x probe \
    && mkdir -p /run/sshd
COPY sshd_config /etc/ssh/probe_config
COPY service.py /opt/probe/service.py
# timeout is PID 1; after killing its direct child it exits, ending the container.
CMD ["timeout", "--signal=KILL", "120", "python3", "/opt/probe/service.py"]
